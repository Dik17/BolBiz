# Copy to .env on the server (never commit .env).
DOMAIN=yourdomain.in
PUBLIC_BASE_URL=https://yourdomain.in

# Claude API key from platform.claude.com
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5
FAST_MODEL=claude-haiku-5-5

# GoDaddy Personal Access Token from developer.godaddy.com (scope: domains.domain:read)
GODADDY_PAT=

# Titan mailbox (hello@yourdomain.in). If login is rejected, keep smtpout.secureserver.net.
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USER=hello@yourdomain.in
SMTP_PASS=
CONTACT_TO=hello@yourdomain.in
